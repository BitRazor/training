<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY: lets a test copy of the app fetch updates from a local test server
     (localhost through "adb reverse", or the emulator's 10.0.2.2) over plain http.
     Release builds keep Android's default: https only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
